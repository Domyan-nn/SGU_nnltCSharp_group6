@model LoginForm
@{
    ViewData["Title"] = "Đăng nhập";
}
<h1>Đăng nhập</h1>
<partial name="_FormErrors" />
<form method="post" action="/tai-khoan/dang-nhap" asp-antiforgery="true" class="stack form-card">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label for="UserName">Tên đăng nhập</label>
        <input asp-for="UserName" autocomplete="username" maxlength="50" required aria-describedby="UserName-err" />
        <span asp-validation-for="UserName" id="UserName-err" class="field-error"></span>
    </div>
    <div class="field">
        <label for="Password">Mật khẩu</label>
        <input asp-for="Password" type="password" autocomplete="current-password" maxlength="100" required aria-describedby="Password-err" />
        <span asp-validation-for="Password" id="Password-err" class="field-error"></span>
    </div>
    <div class="actions">
        <button type="submit">Đăng nhập</button>
    </div>
</form>
<p>Chưa có tài khoản? <a href="/tai-khoan/dang-ky">Đăng ký</a></p>
