@model MenuPageModel
@{
    ViewData["Title"] = "Thực đơn";
    string Vnd(decimal v) => Money.Vnd(v);
    var returnUrl = Context.Request.Path.Add(Context.Request.QueryString);
    var filtered = !string.IsNullOrWhiteSpace(Model.Query) || Model.CategoryId is not null;
}
<h1>Thực đơn</h1>
<p class="note">Dữ liệu minh họa theo hợp đồng API; sẽ nối với thực đơn thật khi máy chủ sẵn sàng.</p>

<form class="filters" method="get" action="/" role="search">
    <div class="field">
        <label for="q">Tìm theo tên món</label>
        <input id="q" name="q" type="search" value="@Model.Query" maxlength="100" autocomplete="off" />
    </div>
    <div class="field">
        <label for="categoryId">Danh mục</label>
        <select id="categoryId" name="categoryId">
            <option value="">Tất cả</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="actions">
        <button type="submit">Tìm</button>
        @if (filtered)
        {
            <a class="button secondary" href="/">Xóa bộ lọc</a>
        }
    </div>
</form>

@if (Model.Products.Count == 0)
{
    <div class="empty" role="status">
        <p>Không tìm thấy món phù hợp.</p>
        <a class="button secondary" href="/">Quay về thực đơn</a>
    </div>
}
else
{
    <p class="count" role="status">@Model.Products.Count món</p>
    <ul class="cards">
        @foreach (var p in Model.Products)
        {
            <li class="card">
                <h2>@p.ProductName</h2>
                <p class="cat">@p.CategoryName <span class="badge ok">Đang bán</span></p>
                <ul class="variants">
                    @foreach (var v in p.Variants)
                    {
                        var qtyId = $"qty-{v.VariantId}";
                        <li class="variant">
                            <form method="post" asp-controller="Cart" asp-action="Add" class="variant-form">
                                <input type="hidden" name="variantId" value="@v.VariantId" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <div class="vhead">
                                    <span class="vname">@v.VariantName</span>
                                    <span class="price">@Vnd(v.UnitPrice)</span>
                                </div>
                                @if (v.Addons.Count > 0)
                                {
                                    <fieldset class="addons">
                                        <legend>Tùy chọn thêm (số lượng mỗi ly)</legend>
                                        @foreach (var a in v.Addons)
                                        {
                                            var addonId = $"addon-{v.VariantId}-{a.AddonVariantId}";
                                            <div class="addon">
                                                <label for="@addonId">@a.Name (+@Vnd(a.UnitPrice)), tối đa @a.MaxPerUnit</label>
                                                <input id="@addonId" name="@("addon_" + a.AddonVariantId)" type="number" inputmode="numeric" min="0" max="@a.MaxPerUnit" step="1" value="0" />
                                            </div>
                                        }
                                    </fieldset>
                                }
                                <div class="buy">
                                    <label for="@qtyId">Số lượng</label>
                                    <input id="@qtyId" name="quantity" type="number" inputmode="numeric" min="1" max="@CartRules.MaxQuantityPerLine" step="1" value="1" required />
                                    <button type="submit" aria-label="@("Thêm " + p.ProductName + " " + v.VariantName + " vào giỏ")">Thêm vào giỏ</button>
                                </div>
                            </form>
                        </li>
                    }
                </ul>
            </li>
        }
    </ul>
}
